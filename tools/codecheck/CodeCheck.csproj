<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Small test program used by tools/check_codes.py. Not part of the mod.
    It compiles the mod's own tune-code files and prints the code for each .trctune file,
    so the Python version can be compared against the exact same C# code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="..\..\src\TuneFingerprint.cs" Link="src\TuneFingerprint.cs" />
    <Compile Include="..\..\src\TuneFile.cs" Link="src\TuneFile.cs" />
    <Compile Include="..\..\src\TuneRules.cs" Link="src\TuneRules.cs" />
    <Compile Include="..\..\src\TuneSets.cs" Link="src\TuneSets.cs" />
    <Compile Include="..\..\src\TuneLabels.cs" Link="src\TuneLabels.cs" />
    <Compile Include="..\..\src\KndFile.cs" Link="src\KndFile.cs" />
    <Compile Include="..\..\src\TuneCheck.cs" Link="src\TuneCheck.cs" />
    <Compile Include="..\..\src\DescSnapshot.cs" Link="src\DescSnapshot.cs" />
    <!-- Courses and time attack, driven by simulated cars in SelfTest.Courses.cs. They use Unity's Vector3, so Unity's core DLL comes from the game. -->
    <Compile Include="..\..\src\Courses\Course.cs" Link="src\Courses\Course.cs" />
    <Compile Include="..\..\src\Courses\CourseGeometry.cs" Link="src\Courses\CourseGeometry.cs" />
    <Compile Include="..\..\src\Courses\CourseFile.cs" Link="src\Courses\CourseFile.cs" />
    <Compile Include="..\..\src\Courses\CourseLibrary.cs" Link="src\Courses\CourseLibrary.cs" />
    <Compile Include="..\..\src\Courses\CourseRecorder.cs" Link="src\Courses\CourseRecorder.cs" />
    <Compile Include="..\..\src\Courses\TimeAttackRun.cs" Link="src\Courses\TimeAttackRun.cs" />
    <Compile Include="..\..\src\Courses\TimeAttackLog.cs" Link="src\Courses\TimeAttackLog.cs" />
    <Compile Include="..\..\src\Courses\TimeAttackTraces.cs" Link="src\Courses\TimeAttackTraces.cs" />
    <Compile Include="..\..\src\Battles\BattleChunks.cs" Link="src\Battles\BattleChunks.cs" />
    <Compile Include="..\..\src\Battles\BattleMessage.cs" Link="src\Battles\BattleMessage.cs" />
    <Compile Include="..\..\src\Battles\BattleRules.cs" Link="src\Battles\BattleRules.cs" />
    <Compile Include="..\..\src\Battles\BattleSession.cs" Link="src\Battles\BattleSession.cs" />
    <Compile Include="..\..\src\TuneBackups.cs" Link="src\TuneBackups.cs" />
    <Compile Include="..\..\src\ICarTuneAdapter.cs" Link="src\ICarTuneAdapter.cs" />
  </ItemGroup>

  <PropertyGroup>
    <CarXPath>D:\SteamLibrary\steamapps\common\CarX Drift Racing Online</CarXPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(CarXPath)\Drift Racing Online_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
